# Optional canonical site URL for Open Graph, sitemap, and robots
# On Render, RENDER_EXTERNAL_URL is used automatically if this is unset
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# Google Gemini AI API Key (Required - Primary AI provider)
# Get it from: https://makersuite.google.com/app/apikey
# Rate limits: Flash: 20/day, Flash-Lite: 20/day
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (Required for Groq fallback + Upgrade agent brief)
# Get it from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs (Required - update when Groq retires/renames models)
# See https://console.groq.com/docs/models and https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
GROQ_UPGRADE_AGENT_MODEL=openai/gpt-oss-20b

# GitHub Personal Access Token (Recommended for security scanning and higher rate limits)
# Get it from: GitHub Settings → Developer settings → Personal access tokens
# Permissions: public_repo (read-only access to public repositories)
# Enables: Security vulnerability scanning via GitHub Advisory Database
# Rate limits: Without token: 60/hour | With token: 5,000/hour
GITHUB_TOKEN=your_github_token_here

# GitHub token used only by the Render release step to push the version commit and tag.
# Contents: Read and write. This is not the GITHUB_TOKEN used for API rate limits.
# Leave unset locally. npm run release does nothing unless RENDER=true.
RELEASE_GITHUB_TOKEN=your_release_github_token_here

# Bearer token for the MCP endpoint at /api/mcp
# Generate a long random value (e.g. openssl rand -hex 32) and set the same on Render.
# The endpoint rejects every request when this is unset.
MCP_API_KEY=your_mcp_api_key_here
# Optional MCP rate limits (per API key, per Render instance, sliding 1-minute window)
# MCP_RATE_LIMIT_PER_MIN=60
# MCP_ANALYSE_RATE_LIMIT_PER_MIN=6

# Supabase project URL and the database password from Project Settings → Database.
# The server inserts anonymous searches with these.
# Use the transaction pooler (port 6543). The user is postgres.<project-ref>.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.your-project-ref
# Prefer base64 on Render (and anywhere $ / # / quotes get mangled).
# Encode the REAL password characters ($ not \$):
#   printf '%s' 'your-real-password' | base64
# Then set POSTGRES_DB_PWD_B64 to that output (no quotes needed).
POSTGRES_DB_PWD_B64=
# Plain password fallback for local .env (quote if it contains $ or #).
POSTGRES_DB_PWD="your_postgres_db_pwd_here"
